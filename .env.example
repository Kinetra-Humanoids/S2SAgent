# Copy to .env and fill in values for your model provider.
OPENAI_API_KEY=

# Optional. OpenAIWhisper also reads this if --openai-base-url is not passed.
OPENAI_BASE_URL=https://api.openai.com/v1/

# Optional tracing keys.
LANGCHAIN_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional Doubao speech keys.
DOUBAO_APP_ID=
DOUBAO_TOKEN=
DOUBAO_ASR_AUTH_MODE=old
DOUBAO_ASR_APP_KEY=
DOUBAO_ASR_ACCESS_KEY=
DOUBAO_ASR_API_KEY=
DOUBAO_TTS_VOICE_TYPE=

# Optional Unitree G1 control.
UNITREE_G1_NETWORK_INTERFACE=
UNITREE_G1_ENABLE_CONTROL=false
UNITREE_G1_AUDIO_APP_NAME=rai_s2s
